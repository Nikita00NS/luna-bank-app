;; Luna Wallet P2P Escrow Smart Contract
;; TON Blockchain - FunC
;; 
;; Features:
;; - HTLC (Hash Time-Locked Contract) for atomic swaps
;; - Multi-party escrow with arbitrator
;; - Fiat payment verification via oracle
;; - Dispute resolution with timeout
;; - Reputation system integration

() recv_internal(int my_balance, int msg_value, cell in_msg_full, slice in_msg_body) impure {
    slice cs = in_msg_full;
    int op = in_msg_body~load_uint(32);
    
    if (op == 0x12345678) { ;; Create Escrow
        create_escrow(cs, in_msg_body, msg_value);
    } else if (op == 0x87654321) { ;; Release Escrow (seller confirms fiat received)
        release_escrow(cs, in_msg_body);
    } else if (op == 0x11223344) { ;; Refund Escrow (buyer cancels / timeout)
        refund_escrow(cs, in_msg_body);
    } else if (op == 0x44332211) { ;; Dispute (arbitrator intervention)
        dispute_escrow(cs, in_msg_body);
    } else if (op == 0x55667788) { ;; Arbitrator resolves
        resolve_dispute(cs, in_msg_body);
    } else {
        throw(0xFFFF); ;; Unknown op
    }
}

() create_escrow(slice cs, slice in_msg_body, int msg_value) impure {
    ;; Parse message
    slice buyer = in_msg_body~load_msg_addr();
    slice seller = in_msg_body~load_msg_addr();
    slice arbitrator = in_msg_body~load_msg_addr();
    int amount = in_msg_body~load_coins();
    int hashlock = in_msg_body~load_uint(256);
    int timelock = in_msg_body~load_uint(64);
    int asset_type = in_msg_body~load_uint(8); ;; 0=TON, 1=Jetton
    slice jetton_wallet = in_msg_body~load_msg_addr();
    
    ;; Validate
    if (amount != msg_value) { throw(0x100); } ;; TON amount mismatch
    if (timelock < now() + 3600) { throw(0x101); } ;; Min 1 hour
    if (timelock > now() + 604800) { throw(0x102); } ;; Max 7 days
    
    ;; Store escrow data
    cell escrow_data = begin_cell()
        .store_uint(0x1, 8)           ;; status: 1=active
        .store_slice(buyer)
        .store_slice(seller)
        .store_slice(arbitrator)
        .store_coins(amount)
        .store_uint(hashlock, 256)
        .store_uint(timelock, 64)
        .store_uint(asset_type, 8)
        .store_slice(jetton_wallet)
        .store_uint(0, 64)            ;; created_at
        .store_uint(0, 256)           ;; secret (empty)
        .end_cell();
    
    ;; Save to storage
    set_data(escrow_data);
    
    ;; Notify buyer and seller
    send_raw_message(begin_cell()
        .store_uint(0x18, 6)
        .store_slice(buyer)
        .store_coins(1)
        .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
        .store_ref(begin_cell()
            .store_uint(0xABCDEF01, 32) ;; EscrowCreated event
            .store_slice(buyer)
            .store_slice(seller)
            .store_coins(amount)
            .store_uint(timelock, 64)
            .end_cell())
        .end_cell());
}

() release_escrow(slice cs, slice in_msg_body) impure {
    slice caller = in_msg_body~load_msg_addr();
    int secret = in_msg_body~load_uint(256);
    
    cell data = get_data();
    slice ds = data;
    
    int status = ds~load_uint(8);
    if (status != 1) { throw(0x200); } ;; Not active
    
    slice seller = ds~load_msg_addr();
    if (!equal_slice_bits(caller, seller)) { throw(0x201); } ;; Only seller
    
    int hashlock = ds~load_uint(256); ds~load_msg_addr(); ds~load_msg_addr(); ds~load_coins(); ds~load_msg_addr();
    int timelock = ds~load_uint(64);
    int asset_type = ds~load_uint(8);
    slice jetton_wallet = ds~load_msg_addr();
    int created_at = ds~load_uint(64);
    int stored_secret = ds~load_uint(256);
    
    ;; Verify secret matches hashlock (SHA256)
    if (sha256(secret) != hashlock) { throw(0x202); }
    
    int amount = ds~load_coins();
    
    ;; Update status to released
    cell new_data = begin_cell()
        .store_uint(2, 8)           ;; status: 2=released
        .store_slice(ds~load_msg_addr()) ;; buyer
        .store_slice(seller)
        .store_slice(ds~load_msg_addr()) ;; arbitrator
        .store_coins(amount)
        .store_uint(hashlock, 256)
        .store_uint(timelock, 64)
        .store_uint(asset_type, 8)
        .store_slice(jetton_wallet)
        .store_uint(created_at, 64)
        .store_uint(secret, 256)
        .end_cell();
    
    set_data(new_data);
    
    ;; Transfer funds to seller
    if (asset_type == 0) {
        ;; Native TON transfer
        send_raw_message(begin_cell()
            .store_uint(0x18, 6)
            .store_slice(seller)
            .store_coins(amount)
            .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
            .store_ref(begin_cell()
                .store_uint(0xABCDEF02, 32) ;; EscrowReleased event
                .store_slice(seller)
                .store_coins(amount)
                .end_cell())
            .end_cell());
    } else {
        ;; Jetton transfer via jetton wallet
        send_raw_message(begin_cell()
            .store_uint(0x18, 6)
            .store_slice(jetton_wallet)
            .store_coins(0.05) ;; forward fee
            .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
            .store_ref(begin_cell()
                .store_uint(0xF8A7EA5, 32) ;; Jetton Transfer op
                .store_uint(0, 64) ;; query_id
                .store_coins(amount)
                .store_slice(seller)
                .store_slice(jetton_wallet)
                .store_uint(0, 1)
                .end_cell())
            .end_cell());
    }
}

() refund_escrow(slice cs, slice in_msg_body) impure {
    slice caller = in_msg_body~load_msg_addr();
    
    cell data = get_data();
    slice ds = data;
    
    int status = ds~load_uint(8);
    if (status != 1) { throw(0x300); } ;; Not active
    
    slice buyer = ds~load_msg_addr();
    slice seller = ds~load_msg_addr();
    ds~load_msg_addr(); ;; arbitrator
    int amount = ds~load_coins();
    int timelock = ds~load_uint(64);
    
    ;; Can refund if: caller is buyer AND timelock expired
    ;; OR caller is arbitrator (emergency)
    slice arbitrator = ds~load_msg_addr();
    
    if (!equal_slice_bits(caller, buyer) && !equal_slice_bits(caller, arbitrator)) {
        throw(0x301); ;; Not authorized
    }
    
    if (equal_slice_bits(caller, buyer) && now() < timelock) {
        throw(0x302); ;; Timelock not expired
    }
    
    int asset_type = ds~load_uint(8);
    slice jetton_wallet = ds~load_msg_addr();
    
    ;; Update status to refunded
    cell new_data = begin_cell()
        .store_uint(3, 8)           ;; status: 3=refunded
        .store_slice(buyer)
        .store_slice(seller)
        .store_slice(arbitrator)
        .store_coins(amount)
        .store_uint(ds~load_uint(256), 256) ;; hashlock
        .store_uint(timelock, 64)
        .store_uint(asset_type, 8)
        .store_slice(jetton_wallet)
        .store_uint(ds~load_uint(64), 64)   ;; created_at
        .store_uint(ds~load_uint(256), 256) ;; secret
        .end_cell();
    
    set_data(new_data);
    
    ;; Transfer funds back to buyer
    if (asset_type == 0) {
        send_raw_message(begin_cell()
            .store_uint(0x18, 6)
            .store_slice(buyer)
            .store_coins(amount)
            .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
            .store_ref(begin_cell()
                .store_uint(0xABCDEF03, 32) ;; EscrowRefunded event
                .store_slice(buyer)
                .store_coins(amount)
                .end_cell())
            .end_cell());
    } else {
        send_raw_message(begin_cell()
            .store_uint(0x18, 6)
            .store_slice(jetton_wallet)
            .store_coins(0.05)
            .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
            .store_ref(begin_cell()
                .store_uint(0xF8A7EA5, 32)
                .store_uint(0, 64)
                .store_coins(amount)
                .store_slice(buyer)
                .store_slice(jetton_wallet)
                .store_uint(0, 1)
                .end_cell())
            .end_cell());
    }
}

() dispute_escrow(slice cs, slice in_msg_body) impure {
    slice caller = in_msg_body~load_msg_addr();
    slice reason = in_msg_body~load_ref().begin_parse().load_string();
    
    cell data = get_data();
    slice ds = data;
    
    int status = ds~load_uint(8);
    if (status != 1) { throw(0x400); } ;; Not active
    
    slice buyer = ds~load_msg_addr();
    slice seller = ds~load_msg_addr();
    slice arbitrator = ds~load_msg_addr();
    
    if (!equal_slice_bits(caller, buyer) && !equal_slice_bits(caller, seller)) {
        throw(0x401); ;; Only parties can dispute
    }
    
    ;; Update status to disputed
    cell new_data = begin_cell()
        .store_uint(4, 8)           ;; status: 4=disputed
        .store_slice(buyer)
        .store_slice(seller)
        .store_slice(arbitrator)
        .store_slice(ds~load_msg_addr()) ;; rest unchanged
        .store_slice(ds~load_msg_addr())
        .store_slice(ds~load_msg_addr())
        .store_slice(ds~load_msg_addr())
        .store_slice(ds~load_msg_addr())
        .end_cell();
    
    set_data(new_data);
    
    ;; Notify arbitrator
    send_raw_message(begin_cell()
        .store_uint(0x18, 6)
        .store_slice(arbitrator)
        .store_coins(1)
        .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
        .store_ref(begin_cell()
            .store_uint(0xABCDEF04, 32) ;; EscrowDisputed event
            .store_slice(caller)
            .store_ref(begin_cell().store_string(reason).end_cell())
            .end_cell())
        .end_cell());
}

() resolve_dispute(slice cs, slice in_msg_body) impure {
    slice caller = in_msg_body~load_msg_addr();
    int resolution = in_msg_body~load_uint(8); ;; 1=buyer wins, 2=seller wins
    
    cell data = get_data();
    slice ds = data;
    
    int status = ds~load_uint(8);
    if (status != 4) { throw(0x500); } ;; Not disputed
    
    slice arbitrator = ds~load_msg_addr(); ds~load_msg_addr(); ds~load_msg_addr();
    
    if (!equal_slice_bits(caller, arbitrator)) { throw(0x501); } ;; Only arbitrator
    
    slice buyer = ds~load_msg_addr();
    slice seller = ds~load_msg_addr();
    int amount = ds~load_coins();
    int asset_type = ds~load_uint(8);
    slice jetton_wallet = ds~load_msg_addr();
    
    slice winner = (resolution == 1) ? buyer : seller;
    int new_status = (resolution == 1) ? 3 : 2; ;; 3=refunded, 2=released
    
    cell new_data = begin_cell()
        .store_uint(new_status, 8)
        .store_slice(buyer)
        .store_slice(seller)
        .store_slice(arbitrator)
        .store_slice(ds~load_msg_addr())
        .store_slice(ds~load_msg_addr())
        .store_slice(ds~load_msg_addr())
        .store_slice(ds~load_msg_addr())
        .end_cell();
    
    set_data(new_data);
    
    ;; Transfer to winner
    if (asset_type == 0) {
        send_raw_message(begin_cell()
            .store_uint(0x18, 6)
            .store_slice(winner)
            .store_coins(amount)
            .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
            .store_ref(begin_cell()
                .store_uint(0xABCDEF05, 32) ;; DisputeResolved event
                .store_slice(winner)
                .store_uint(resolution, 8)
                .store_coins(amount)
                .end_cell())
            .end_cell());
    } else {
        send_raw_message(begin_cell()
            .store_uint(0x18, 6)
            .store_slice(jetton_wallet)
            .store_coins(0.05)
            .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
            .store_ref(begin_cell()
                .store_uint(0xF8A7EA5, 32)
                .store_uint(0, 64)
                .store_coins(amount)
                .store_slice(winner)
                .store_slice(jetton_wallet)
                .store_uint(0, 1)
                .end_cell())
            .end_cell());
    }
}

() sha256(int x) inline_ref 0x1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef asm "HASHU" impure;

() get_data() inline_ref get_data asm "GETDATA" impure;
() set_data(cell x) inline_ref set_data asm "SETDATA" impure;
() now() inline_ref now asm "NOW" impure;
() equal_slice_bits(slice a, slice b) inline asm "EQ" impure;